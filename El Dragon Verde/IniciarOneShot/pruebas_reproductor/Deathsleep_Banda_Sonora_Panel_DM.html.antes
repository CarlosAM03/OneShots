<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" content="#101b19" />
<meta name="description" content="Cabina musical interactiva para dirigir Deathsleep: El Dragón entre Nosotros, cuatro actos, 26 escenas y tres finales." />
<title>Deathsleep · Cabina de banda sonora</title>
<style>
:root{--bg:#0c1211;--panel:#16201d;--panel2:#1b2824;--ink:#f0eadb;--muted:#b4b8aa;--faint:#77887f;--accent:#d5b67d;--green:#9fbd9b;--border:#455447;--red:#c68376;--space:clamp(14px,3vw,32px);color-scheme:dark}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:var(--ink);background:radial-gradient(ellipse at 50% -5%,#244036 0,transparent 37%),radial-gradient(ellipse at 100% 85%,#1a2924 0,transparent 50%),var(--bg);min-height:100vh;line-height:1.5}button,input,a{font:inherit}button{cursor:pointer}a{color:inherit}button:focus-visible,input:focus-visible,a:focus-visible{outline:2px solid #f3db9f;outline-offset:3px}button:disabled{opacity:.35;cursor:not-allowed}
.container{max-width:1410px;margin:auto;padding:0 var(--space)}.serif{font-family:Georgia,'Times New Roman',serif}.eyebrow{letter-spacing:.18em;text-transform:uppercase;font-size:.7rem;color:var(--accent);font-weight:700}.masthead{padding:37px 0 26px;border-bottom:1px solid #544937;position:relative}.masthead:before{content:' ';position:absolute;inset:0;pointer-events:none;background:linear-gradient(110deg,transparent 50%,rgba(110,137,103,.07))}.masthead .container{position:relative}.masthead h1{font:normal clamp(2.25rem,6vw,5.2rem)/.98 Georgia,serif;letter-spacing:.075em;margin:10px 0 10px;color:#f3e9d0;text-shadow:0 3px 21px #000}.masthead h1 span{color:var(--accent)}.masthead p{max-width:825px;color:#c8c8b8;margin:10px 0}.meta-row{display:flex;flex-wrap:wrap;gap:9px;margin-top:18px}.meta-chip{background:#1d2824;border:1px solid #435448;border-radius:7px;color:#dfd5be;font-size:.78rem;padding:6px 10px}.jumpbar{display:flex;justify-content:space-between;align-items:center;gap:14px;margin-top:24px}.jumpbar a{text-decoration:none;font-weight:700;color:var(--accent);border-bottom:1px dotted #948564;padding-bottom:3px;font-size:.9rem}
.quick{margin:27px 0 51px;scroll-margin-top:20px}.quick-shell{border:1px solid #806f4f;background:linear-gradient(155deg,#17241f,#101b18 75%);box-shadow:0 20px 70px #050d0b;border-radius:14px;overflow:clip}.quick-heading{display:flex;align-items:end;justify-content:space-between;gap:14px;flex-wrap:wrap;padding:23px 24px 13px}.quick-heading h2{font:normal clamp(1.5rem,3vw,2.25rem) Georgia,serif;margin:3px 0}.quick-heading p{color:var(--muted);margin:0;max-width:750px;font-size:.91rem}.progress{text-align:right;color:var(--muted);font-size:.8rem}.progress b{color:var(--accent);font-size:1.12rem}.progress-track{width:155px;height:5px;background:#314039;border-radius:99px;margin-top:7px;overflow:hidden}.progress-fill{background:linear-gradient(90deg,#9a895f,#d1ba85);height:100%;width:0;transition:width .25s}
.act-tabs{display:flex;overflow-x:auto;gap:6px;padding:13px 22px 15px;scrollbar-width:thin;border-bottom:1px solid #37473d}.act-tab{flex:0 0 auto;border:1px solid #465848;background:#1c2a23;color:#c7c7b7;border-radius:8px;padding:10px 15px;white-space:nowrap;font-weight:720;font-size:.88rem}.act-tab:hover{background:#293b30}.act-tab.active{background:#9a8155;color:#100f0c;border-color:#d5bb8c}.act-tab small{font-size:.75rem;font-weight:500;opacity:.8}.cabina-grid{display:grid;grid-template-columns:minmax(0,1.28fr) minmax(315px,.85fr);gap:0}.stage{padding:23px 25px 28px;min-width:0}.stage-sub{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-bottom:11px}.tag{font-size:.73rem;border:1px solid #526251;padding:4px 8px;color:#d3d9c5;border-radius:5px;background:#27352b}.tag.opt{border-color:#b49054;color:#e0c58d}.tag[class*=Combate]{border-color:#9f6661;color:#e7afa6}.scene-counter{margin-left:auto;color:var(--faint);font-size:.8rem}.stage h3{font:normal clamp(1.52rem,2.7vw,2.35rem)/1.2 Georgia,serif;margin:0 0 9px;letter-spacing:.01em}.cue{padding:12px 14px;background:#273529;border-left:3px solid var(--accent);border-radius:0 8px 8px 0;color:#d7d8ca;margin:16px 0;font-size:.9rem}.cue b{color:#e8c991}.track-card{border:1px solid #546a53;border-radius:11px;background:linear-gradient(145deg,#1d3328,#19241f);padding:17px;display:flex;gap:13px;align-items:center}.record-icon{display:grid;place-items:center;flex:0 0 54px;height:54px;border:2px solid #bb9d68;border-radius:50%;font-size:1.45rem;color:#d8b980;background:radial-gradient(circle,#263d2c 0 30%,#17251e 31% 100%)}.track-card strong{display:block;font-size:1.04rem}.track-card small{color:var(--muted)}.stage-desc{font-size:.9rem;line-height:1.7;color:#c6cbbb;margin:17px 0 14px}.alt-note{font-size:.83rem;color:#e1c991;margin:0 0 14px}.actions{display:flex;flex-wrap:wrap;gap:8px}.action{display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:8px;border:1px solid #627062;padding:11px 14px;background:#24342a;color:#e8ede2;font-weight:750;min-height:43px;text-decoration:none;font-size:.9rem;transition:background .15s,transform .15s}.action:hover{transform:translateY(-1px);background:#314535}.action.primary{background:#ccad75;border-color:#f0cf92;color:#181713}.action.primary:hover{background:#e1c28b}.action.ghost{background:transparent}.action.warn{border-color:#9d655d;color:#f4c2b6}.action.active-fav{background:#4c3b23;color:#e9c782}.action.small{padding:7px 11px;font-size:.79rem;min-height:34px}.control-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.control-row .action{flex:1}.control-row .action.stretch{flex:1.4}.now-status{color:#9eae9f;font-size:.8rem;margin:11px 0 6px;min-height:19px}.player-shell{background:#0b1210;border:1px solid #405447;border-radius:9px;overflow:hidden;margin-top:9px}.player-placeholder{padding:20px 15px;color:#9aaa98;font-size:.85rem;text-align:center;background:repeating-linear-gradient(45deg,#17231d,#17231d 8px,#1a2821 8px,#1a2821 16px)}.yt-frame{width:100%;aspect-ratio:16/9;display:block;border:0}.queue{border-left:1px solid #3e4d40;padding:17px 16px 17px 19px;min-width:0;background:#15211b}.queue-head{display:flex;justify-content:space-between;align-items:center;gap:8px}.queue h3{font:normal 1.18rem Georgia,serif;margin:0}.queue-count{font-size:.72rem;color:#b1b6a7}.search{display:block;width:100%;border:1px solid #52634f;background:#0f1815;color:#e5e6dd;border-radius:8px;padding:11px 12px;margin:12px 0 8px}.search::placeholder{color:#8c9c8d}.filter-row{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:12px}.filter{border:1px solid #485a4c;border-radius:6px;background:#1c2c23;padding:5px 9px;color:#cdd4c6;font-size:.75rem}.filter.on{background:#665737;border-color:#c5a86f;color:white}.queue-list{max-height:590px;overflow:auto;padding-right:3px;scrollbar-color:#726b50 #17251d}.queue-item{border:1px solid #394b3c;background:#192820;border-radius:9px;margin-bottom:7px;display:grid;grid-template-columns:1fr auto;gap:7px;align-items:center;padding:4px}.queue-item.current{border-color:#d2b77e;background:#293728;box-shadow:inset 3px 0 #d2b77e}.queue-select{display:flex;align-items:center;text-align:left;gap:10px;background:none;border:0;min-width:0;color:#e6e4d7;padding:8px 6px}.queue-index{font:normal 1.16rem Georgia,serif;color:#b0a078;min-width:29px}.queue-main{min-width:0}.queue-main strong{display:block;font-size:.79rem;line-height:1.3}.queue-main small{font-size:.69rem;color:#9daf9a}.queue-tools{display:flex;gap:2px}.mini{height:33px;min-width:31px;border:0;background:none;color:#c7d3bc;border-radius:6px}.mini:hover{background:#354732}.mini.fav{color:#f0cc7b}.mini.done{color:#96c8a6}.empty{text-align:center;color:#bbc9b5;padding:27px 12px;font-size:.86rem}.queue-tip{font-size:.74rem;color:#98a897;margin:13px 4px 0}
.guide{scroll-margin-top:30px;padding-bottom:48px}.guide-head{display:flex;flex-wrap:wrap;gap:10px;justify-content:space-between;align-items:end;margin-bottom:16px}.guide h2{font:normal clamp(1.7rem,3vw,2.8rem) Georgia,serif;margin:0}.guide-intro{max-width:875px;color:#b5c1b4;font-size:.93rem;margin-bottom:28px}.guide-chips{display:flex;gap:6px;flex-wrap:wrap}.guide-chips button{background:#1c2821;color:#ccdac9;border:1px solid #45564a;border-radius:99px;padding:8px 12px;font-size:.79rem}.guide-chips button.selected{background:#a68e60;color:#151b14}.act-section{margin:0 0 46px;scroll-margin-top:80px}.act-banner{height:210px;border:1px solid #5b5949;border-radius:12px;position:relative;background-color:#314039;background-size:cover;background-position:center;overflow:hidden;display:flex;align-items:end}.act-banner:before{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(4,10,8,.87),rgba(4,10,8,.45) 54%,rgba(4,10,8,.25)),linear-gradient(0deg,rgba(0,0,0,.6),transparent 75%)}.act-banner >div{position:relative;padding:25px;max-width:700px}.act-banner h3{font:normal clamp(1.5rem,3vw,2.4rem) Georgia,serif;margin:0 0 6px}.act-banner p{font-size:.85rem;color:#e4dcc7;margin:0}.scene-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px;margin:17px 0}.detail{background:linear-gradient(135deg,#17241e,#18231f);border:1px solid #394a3f;border-radius:10px;padding:17px;scroll-margin-top:120px}.detail .topline{display:flex;align-items:center;gap:9px;flex-wrap:wrap;color:var(--accent);font-size:.73rem;font-weight:800;letter-spacing:.08em}.detail h4{font:normal 1.29rem/1.2 Georgia,serif;margin:10px 0 7px}.detail .sub{font-size:.79rem;color:#acc3a5}.detail .musictitle{font-weight:750;margin:11px 0 5px;color:#ecd3a6}.detail .musictitle span{font-weight:400;color:#b5c0b1}.detail p{font-size:.88rem;color:#c1cabe;line-height:1.65}.detail .when{border-left:2px solid #98815a;padding-left:10px;color:#dfd2bd}.detail-links{display:flex;gap:8px;flex-wrap:wrap;margin-top:13px}.transition{border:1px solid #65573f;background:rgba(97,76,46,.17);padding:13px 16px;border-radius:8px;font-size:.87rem;color:#d8ccad}.transition strong{color:#e0bd7d}.hidden{display:none!important}.tips{border-top:1px solid #394a3f;padding:22px 0 56px}.tips h2{font:normal 1.95rem Georgia,serif}.tips p{color:#c4c8bc;max-width:950px}.tips-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.tip{border:1px solid #425243;border-radius:10px;background:#17221d;padding:18px}.tip b{display:block;color:#e4c18a;margin-bottom:6px}.tip p{font-size:.87rem;margin:0}.foot{border-top:1px solid #38473a;padding:24px 0 55px;color:#98a999;font-size:.79rem}.mobile-dock{display:none}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
@media(max-width:850px){.cabina-grid{grid-template-columns:1fr}.queue{border-left:0;border-top:1px solid #455647;padding:16px 18px}.queue-list{max-height:335px}.stage{padding:18px}.scene-grid{grid-template-columns:1fr}.tips-grid{grid-template-columns:1fr}.quick-heading{padding:20px 18px 10px}.act-tabs{padding:10px 15px}.act-banner{height:175px}.queue-tip{display:none}}
@media(max-width:530px){body{font-size:14px}.masthead{padding-top:25px}.masthead h1{letter-spacing:.025em}.quick{margin-top:18px}.quick-heading h2{font-size:1.42rem}.progress{width:100%;display:flex;gap:8px;align-items:center;justify-content:space-between}.progress-track{flex:1;margin:0}.stage h3{font-size:1.55rem}.track-card{padding:13px}.record-icon{flex-basis:43px;height:43px}.control-row .action{font-size:.76rem;padding:9px 7px}.actions .action{flex:1}.act-banner>div{padding:17px}.act-banner h3{font-size:1.48rem}.act-banner p{font-size:.79rem}.mobile-dock{display:grid;grid-template-columns:1fr auto auto;align-items:center;gap:7px;position:fixed;bottom:0;left:0;right:0;z-index:80;background:#101c16eF;border-top:1px solid #a78d5e;padding:10px max(12px,env(safe-area-inset-right)) calc(10px + env(safe-area-inset-bottom)) max(12px,env(safe-area-inset-left));backdrop-filter:blur(12px);box-shadow:0 -7px 25px #050b07}.mobile-dock span{font-size:.72rem;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.mobile-dock button{background:#d0b47f;color:#181714;border:none;border-radius:7px;padding:9px 12px;font-weight:800}.foot{padding-bottom:100px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{transition:none!important}}
</style>
</head>
<body>
<header class="masthead"><div class="container">
<div class="eyebrow">DEATHSLEEP · EL DRAGÓN ENTRE NOSOTROS</div>
<h1>LA <span>BANDA SONORA</span><br>DEL ONE-SHOT</h1>
<p>Cabina musical para el Dungeon Master: cuatro actos, escenas en orden de juego, encuentros opcionales y tres desenlaces. Sonidos de fantasía oscura, tenebrismo y horror ancestral.</p>
<div class="meta-row"><span class="meta-chip">D&amp;D 5e · Guía del Volumen I</span><span class="meta-chip">26 escenas + 3 finales + epílogo</span><span class="meta-chip">Pistas largas · YouTube</span><span class="meta-chip">Funciona como HTML local</span></div>
<div class="jumpbar"><a href="#cabina">↓ Abrir panel de dirección</a><a href="#guia">↓ Ver guía completa</a></div>
</div></header>
<main class="container">
<section class="quick" id="cabina" aria-labelledby="cabina-title"><div class="quick-shell">
<div class="quick-heading"><div><div class="eyebrow">Control en tiempo real</div><h2 id="cabina-title">Panel rápido del Dungeon Master</h2><p>Selecciona una escena y reproduce su pista sin desplazarte por toda la guía. Los cambios de escena no interrumpen la música hasta que pulses reproducir.</p></div><div class="progress"><span>Escenas completadas: <b id="progressCount">0/30</b></span><div class="progress-track"><div class="progress-fill" id="progressFill"></div></div></div></div>
<div class="act-tabs" id="actTabs" role="tablist" aria-label="Filtrar escenas por acto"></div>
<div class="cabina-grid">
<div class="stage" id="stage" aria-live="polite"></div>
<aside class="queue" aria-label="Cola rápida de escenas"><div class="queue-head"><h3>Escenas del acto</h3><span class="queue-count" id="queueCount"></span></div><label class="sr-only" for="sceneSearch">Buscar escena o pista</label><input id="sceneSearch" class="search" type="search" placeholder="Buscar escena, enemigo, pista..." autocomplete="off"/><div class="filter-row"><button class="filter" type="button" id="onlyFavorites" aria-pressed="false">☆ Favoritas</button><button class="filter" type="button" id="onlyPending" aria-pressed="false">○ Pendientes</button><button class="filter" type="button" id="allScenes" aria-pressed="false">Todos los actos</button></div><div class="queue-list" id="queueList" tabindex="0"></div><p class="queue-tip">Pulsa una escena para verla; ▶ reproduce de inmediato. ★ guarda favoritas. ✓ marca las ya utilizadas.</p></aside>
</div>
</div></section>
<section id="guia" class="guide"><div class="guide-head"><div><div class="eyebrow">Volumen I · Uso en mesa</div><h2>Guía detallada por actos</h2></div><div class="guide-chips" id="guideFilters" aria-label="Filtrar guía por tipo de escena"></div></div>
<p class="guide-intro">Las pistas mantienen el orden narrativo del one-shot. Cambia de música cuando ocurra el desencadenante indicado y no según el tiempo transcurrido. La hidra, el basilisco y otros encuentros pueden evitarse o no suceder; no actives música de combate hasta que haya un enfrentamiento.</p><div id="detailedGuide"></div></section>
<section class="tips" aria-labelledby="tips-title"><div class="eyebrow">Notas para la dirección</div><h2 id="tips-title">Cómo usar la música durante la partida</h2><div class="tips-grid">
<div class="tip"><b>01 · No anticipar la identidad</b><p>Evita la música del dragón antes de que Elarion se revele. La tensión debe construirse con pistas, no con un tema de combate prematuro.</p></div>
<div class="tip"><b>02 · El valor del silencio</b><p>Justo antes de pronunciar «Deathsleep», pausa la pista unos segundos. El retorno del sonido en la manifestación crea contraste.</p></div>
<div class="tip"><b>03 · Eco y la Canción de Descanso</b><p>Si diriges la adaptación con Eco, deja que su voz destaque durante el descanso; Long Rest debe quedar de fondo, no sustituir su canto.</p></div>
<div class="tip"><b>04 · Diálogos por encima de todo</b><p>Mantén la música a volumen bajo al negociar con Rizk, el ettercap o Deathsleep. El tono no debe impedir escuchar decisiones y promesas.</p></div>
<div class="tip"><b>05 · Tres motivos reconocibles</b><p>Mysterious Forest para el misterio, Dark Ritual para la presencia ancestral y The End of the Quest para la conclusión elegida.</p></div>
<div class="tip"><b>06 · Respaldo y derechos</b><p>Abre los enlaces antes de la sesión por posibles anuncios, bloqueos o cambios. El uso en un video o retransmisión puede requerir autorización de los titulares.</p></div>
</div></section>
</main>
<div class="mobile-dock" id="mobileDock" aria-label="Accesos rápidos para móvil"><span id="dockTitle">Selecciona una escena</span><button id="dockPlay" type="button">▶</button><button id="dockNext" type="button">Siguiente ›</button></div>
<footer class="foot"><div class="container">DEATHSLEEP · Guía sonora personalizada basada en el Volumen I. Los títulos y enlaces de YouTube proceden de la selección facilitada; su disponibilidad y duración pueden cambiar. El HTML funciona sin conexión para consultar la guía y guardar el progreso; la reproducción requiere Internet.</div></footer>
<script>
'use strict';
const acts=[{"id":"1","roman":"I","name":"Neverwinter","subtitle":"El mercado y la niebla","duration":"45–55 min","mood":"Ciudad medieval, peligro repentino y misterio sobrenatural.","transition":"Cuando la niebla desaparezca y se revelen las escaleras hacia las ruinas, baja gradualmente el combate y cambia al ambiente subterráneo del segundo acto.","picture":"data:image/webp;base64,"},{"id":"2","roman":"II","name":"Gauntlgrym","subtitle":"Hornos, runas y telarañas","duration":"50–60 min","mood":"Ruinas enanas monumentales, maquinaria olvidada y criaturas subterráneas.","transition":"Al salir de Gauntlgrym, mantén unos instantes el sonido subterráneo y cambia al ambiente volcánico cuando describas la primera caída de ceniza.","picture":"data:image/webp;base64,"},{"id":"3","roman":"III","name":"Monte Hotenow","subtitle":"Ceniza y juramentos","duration":"40–55 min","mood":"Calor insoportable, ceniza, muerte antigua y peligros que pueden evitarse.","transition":"Al comenzar el cuarto acto, elimina los sonidos de fuego y roca: el contraste con un bosque extrañamente silencioso será más inquietante.","picture":"data:image/webp;base64,"},{"id":"4","roman":"IV","name":"Bosque de Neverwinter","subtitle":"La verdad","duration":"65–80 min","mood":"Horror psicológico, rescate, revelación y decisiones morales.","transition":"No anticipes musicalmente la identidad de Deathsleep: el golpe dramático llega con la revelación, y el tema de jefe se reserva para un combate real.","picture":"data:image/webp;base64,"},{"id":"F","roman":"✧","name":"Desenlaces","subtitle":"Tres finales y epílogo","duration":"Según decisión","mood":"Pacto, tregua, ruptura de sellos y regreso a Neverwinter.","transition":"Elige solamente el final que ocurrió. Los demás quedan disponibles como rutas alternativas.","picture":"data:image/webp;base64,"}];
const scenes=[{"id":1,"act":"1","name":"Mercado de Neverwinter — Llegada y exploración","category":"Exploración","feel":"Animado, cotidiano y medieval","title":"Marketplace","artist":"Bardify","videoId":"-r9cvBWjGKM","desc":"Reprodúcela mientras describes los puestos, comerciantes, guardias y la llegada de las aventureras. Todavía debe sentirse como una ciudad segura.","trigger":"Cuando las aventureras llegan al mercado.","optional":false,"alternate":""},{"id":2,"act":"1","name":"Secuestro de Maela — Hombres rata","category":"Combate","feel":"Urgencia y peligro","title":"1 Hour of Combat Music for D&D","artist":"DnDmusic","videoId":"eT_m2yZpnHc","desc":"Cambia a esta pista cuando el carro vuelque y los hombres rata aparezcan. Puede mantenerse durante el combate y la persecución por los callejones.","trigger":"Cuando los contrabandistas irrumpen en el mercado.","optional":false,"alternate":""},{"id":3,"act":"1","name":"Investigación con Maela y el sargento Branik","category":"Investigación","feel":"Sospecha y preocupación","title":"Investigating a Mystery","artist":"Bardify","videoId":"7wBzL62Va1k","desc":"Úsala al descubrir que la hermana de Maela también desapareció, investigar el medallón y recibir el mapa de Branik.","trigger":"Tras el rescate de Maela, en los interrogatorios.","optional":false,"alternate":""},{"id":4,"act":"1","name":"Presentación de Elarion y salida de Neverwinter","category":"Diálogo","feel":"Bondad aparente y melancolía","title":"A New Dawn","artist":"Bardify","videoId":"FT4QX_9NhAY","desc":"Debe acompañar al anciano mientras cura a los heridos y se ofrece como guía. Evita una música maligna: todavía debe inspirar confianza.","trigger":"Cuando Elarion ayuda a los heridos.","optional":false,"alternate":""},{"id":5,"act":"1","name":"Camino de la niebla impenetrable","category":"Exploración","feel":"Desorientación y horror sutil","title":"Mysterious Forest","artist":"Bardify","videoId":"4Y6n-1XQSfE","desc":"Comienza cuando descubran los tres senderos idénticos. Déjala sonar durante las pruebas de orientación y la voz misteriosa.","trigger":"Al aparecer los tres senderos idénticos.","optional":false,"alternate":""},{"id":6,"act":"1","name":"Hidra espectral — Encuentro opcional","category":"Combate","feel":"Persecución y horror sobrenatural","title":"Deadly Combat","artist":"RPG Soundtracks","videoId":"m-1S1V1PZHA","desc":"Solo actívala si la hidra surge tras los fallos del desafío. Debe impulsar una huida desesperada, no sugerir que tienen que derrotar a la hidra.","trigger":"Solo si la hidra aparece en la niebla.","optional":true,"alternate":""},{"id":7,"act":"2","name":"Entrada a Gauntlgrym — Gran forja abandonada","category":"Exploración","feel":"Ruinas y profundidad","title":"Common Dungeon","artist":"Michael Ghelfi Studios","videoId":"M7iPE6-OvzA","desc":"Ideal para la entrada, pasadizos, exploración de hornos y búsqueda de huellas. Es una ambientación de mazmorra con sonidos inquietantes.","trigger":"Al descender a las galerías enanas.","optional":false,"alternate":""},{"id":8,"act":"2","name":"Gólems de cerámica — Despertar de los guardianes","category":"Combate","feel":"Mecánico y amenazante","title":"Deadly Combat","artist":"RPG Soundtracks","videoId":"m-1S1V1PZHA","desc":"Úsala si los constructos atacan. Si las jugadoras los evitan o desactivan en secreto, conserva Common Dungeon para no transformar la investigación en una batalla obligatoria.","trigger":"Solo si el mecanismo de los gólems provoca combate.","optional":false,"alternate":"Si se desactivan con las runas: conserva Common Dungeon."},{"id":9,"act":"2","name":"Corredor del Hook Horror — Cazador del techo","category":"Tensión","feel":"Acecho subterráneo","title":"Underdark","artist":"Bardify","videoId":"_8A8N9BI6T4","desc":"Excelente para los sonidos de ganchos contra la piedra, la criatura que protege su nido y las decisiones de sigilo.","trigger":"Cuando se perciban golpes desde el techo.","optional":true,"alternate":"Si el acecho se convierte en combate: cambia a Deadly Combat."},{"id":10,"act":"2","name":"Cámara de las voces — Inscripciones y misterio","category":"Investigación","feel":"Conocimiento ancestral","title":"1-Hour Dark & Mystery Background Music","artist":"FaboMusic","videoId":"tFxmITgwIDs","desc":"Aquí revelarán pistas sobre las tres anclas y Elarion podrá demostrar que conoce más de lo que aparenta.","trigger":"Al descubrir los relieves y runas de la cámara.","optional":false,"alternate":""},{"id":11,"act":"2","name":"Arco de las telarañas — El ettercap","category":"Diálogo","feel":"Negociación amenazante y horror arácnido","title":"Tense Negotiations","artist":"Bardify","videoId":"RPkHu8M_U4c","desc":"Comienza cuando el ettercap descienda y pregunte qué ofrecen para cruzar. Si empieza a atacar, cambia a Deadly Combat.","trigger":"Cuando el ettercap haga su exigencia.","optional":false,"alternate":"Si ataca: cambia a Deadly Combat."},{"id":12,"act":"2","name":"Refugio de la puerta de bronce — Descanso corto","category":"Descanso","feel":"Alivio después del horror","title":"Long Rest","artist":"Bardify","videoId":"7T3SU4Ht1Yw","desc":"Acompaña la recuperación, la búsqueda de pociones y la conversación sobre la inscripción: «El guardián del bosque no siempre lleva escamas».","trigger":"Al cerrar la puerta de bronce y descansar.","optional":false,"alternate":""},{"id":13,"act":"3","name":"Laderas del Monte Hotenow — Travesía volcánica","category":"Exploración","feel":"Fuego y roca","title":"Volcano","artist":"Bardify","videoId":"tor8d3IgZ1w","desc":"Contiene sonido ambiental volcánico. Reprodúcelo para que las jugadoras perciban la montaña como una amenaza constante, incluso cuando no haya enemigos.","trigger":"En cuanto caiga ceniza sobre el camino.","optional":false,"alternate":""},{"id":14,"act":"3","name":"Grietas, terreno inestable y peligros naturales","category":"Exploración","feel":"Presión y aislamiento","title":"Volcano Temple","artist":"Michael Ghelfi Studios","videoId":"fUN-T3zwAYc","desc":"Úsala para los riesgos de terreno, los pasos estrechos y las estructuras volcánicas abandonadas.","trigger":"Cuando el terreno obligue a extremar precauciones.","optional":false,"alternate":""},{"id":15,"act":"3","name":"Paso de los muertos — Patrulla de esqueletos","category":"Combate","feel":"Muertos vivientes","title":"Skeleton Battle","artist":"Bardify","videoId":"zp8ZlBUGdgs","desc":"Hazla comenzar cuando los esqueletos se levanten de la ceniza. Si el grupo decide rodearlos sigilosamente, conserva Volcano Temple.","trigger":"Cuando los esqueletos se levanten.","optional":false,"alternate":"Si los esquivan: conserva Volcano Temple."},{"id":16,"act":"3","name":"Santuario de las estatuas — Presencia del basilisco","category":"Tensión","feel":"Terror y sigilo: temor a mirar","title":"Dungeon Room","artist":"Michael Ghelfi Studios","videoId":"upmAf3wWKKo","desc":"Para explorar las estatuas petrificadas y evitar la mirada del monstruo. Si combaten, utiliza nuevamente Deadly Combat.","trigger":"Al ver las víctimas convertidas en piedra.","optional":true,"alternate":"Si combaten: cambia a Deadly Combat."},{"id":17,"act":"3","name":"Rizk el Custodio — El kobold del paso","category":"Diálogo","feel":"Tensión con humor contenido","title":"Tense Negotiations","artist":"Bardify","videoId":"RPkHu8M_U4c","desc":"Déjala sonar mientras Rizk impone sus condiciones y reconoce algo extraño en Elarion. Evita una música de combate salvo que las jugadoras lo ataquen.","trigger":"Cuando Rizk bloquee el camino.","optional":false,"alternate":"Si el grupo ataca: cambia a Deadly Combat."},{"id":18,"act":"3","name":"Refugio de cazadores — Último descanso","category":"Descanso","feel":"Cansancio y tranquilidad melancólica","title":"Long Rest","artist":"Bardify","videoId":"7T3SU4Ht1Yw","desc":"Úsala para la recuperación antes de entrar al bosque y las últimas conversaciones con el anciano.","trigger":"Cuando lleguen a la cabaña de cazadores.","optional":false,"alternate":""},{"id":19,"act":"4","name":"Entrada al Bosque de Neverwinter","category":"Exploración","feel":"Belleza enferma","title":"Forest (Night)","artist":"Bardify","videoId":"NvBS6NWewxU","desc":"Sonidos de bosque nocturno para introducir las raíces, las piedras rúnicas y la extraña quietud. Mantén un volumen bajo.","trigger":"Al cruzar el umbral del bosque.","optional":false,"alternate":""},{"id":20,"act":"4","name":"La espesura observa — Pistas sobre Elarion","category":"Tensión","feel":"Identidad oculta","title":"Mysterious Forest","artist":"Bardify","videoId":"4Y6n-1XQSfE","desc":"Cuando las raíces reaccionen a Elarion o una pista sugiera que no es quien aparenta, cambia a esta música. No reveles aún el nombre del dragón.","trigger":"Cuando las plantas reaccionen al anciano.","optional":false,"alternate":""},{"id":21,"act":"4","name":"Abrigo de piedra — Rescate de los cautivos","category":"Diálogo","feel":"Alivio y responsabilidad humana","title":"A New Dawn","artist":"Bardify","videoId":"FT4QX_9NhAY","desc":"Cambia a esta pieza cuando descubran que las personas desaparecidas siguen vivas. Así la música refuerza el rescate sin convertirlo en otra escena de horror.","trigger":"Cuando encuentren a los cautivos vivos.","optional":false,"alternate":""},{"id":22,"act":"4","name":"Claro ancestral — Exploración de las tres runas","category":"Investigación","feel":"Misterio ritual y contención","title":"Dark Ritual","artist":"Bardify","videoId":"5Y7oXb_Vmsc","desc":"Iníciala cuando descubran las tres anclas: raíz, roca y agua. Debe sugerir un poder antiguo sin confirmar todavía su origen.","trigger":"Cuando lleguen al círculo ancestral.","optional":false,"alternate":""},{"id":23,"act":"4","name":"Elarion confiesa su responsabilidad","category":"Diálogo","feel":"Traición y culpa","title":"Tragic Betrayal","artist":"Bardify","videoId":"HNd7P7C-lWg","desc":"Úsala mientras reconoce que conocía los secuestros y permitió que continuaran. La sensación debe ser de decepción moral, no de simple villanía.","trigger":"Cuando Elarion admita su inacción.","optional":false,"alternate":""},{"id":24,"act":"4","name":"La máscara se rompe — Revelación de Deathsleep","category":"Revelación","feel":"Horror ancestral","title":"Dark Ritual","artist":"Bardify","videoId":"5Y7oXb_Vmsc","desc":"Mantén la pista ritual mientras Elarion se endereza y su sombra despliega alas. Justo antes de pronunciar «Deathsleep», baja la música a silencio durante unos segundos. Después muestra la imagen del dragón.","trigger":"En el instante en que Elarion revela su identidad.","optional":false,"alternate":"Pausa unos segundos justo antes de pronunciar «Deathsleep»."},{"id":25,"act":"4","name":"Negociación con Deathsleep — Pacto o tregua","category":"Diálogo","feel":"Respeto, peligro y poder","title":"Tense Negotiations","artist":"Bardify","videoId":"RPkHu8M_U4c","desc":"La conversación debe sentirse peligrosa. No uses música de victoria porque Deathsleep acepte hablar: sigue siendo una criatura manipuladora y formidable.","trigger":"Cuando el dragón permita hablar.","optional":false,"alternate":""},{"id":26,"act":"4","name":"Combate contra Deathsleep — Ruta alternativa","category":"Combate","feel":"Jefe final: tres anclas","title":"Battling the Ancient Dragon","artist":"FaboMusic","videoId":"sWE6jVYLPto","desc":"Actívala únicamente si las jugadoras deciden enfrentarse a la manifestación y desactivar los sellos. Es la opción más épica de toda la lista.","trigger":"Únicamente si hay enfrentamiento contra la manifestación.","optional":true,"alternate":"No debe sonar si el grupo pacta o se retira."},{"id":27,"act":"F","name":"Final A — Pacto voluntario con Deathsleep","category":"Desenlace","feel":"Victoria íntima y elección","title":"The End of the Quest","artist":"Bardify","videoId":"9GfNlO0tBXk","desc":"Para el acuerdo, las marcas recíprocas si son aceptadas y la despedida. Una victoria íntima, no una conquista.","trigger":"Cuando ambas partes acepten los términos del pacto.","optional":false,"alternate":""},{"id":28,"act":"F","name":"Final B — Tregua sin vínculo","category":"Desenlace","feel":"Retirada libre y reflexiva","title":"A New Dawn","artist":"Bardify","videoId":"FT4QX_9NhAY","desc":"Para una retirada libre y reflexiva. Las protagonistas regresan vivas sin contraer compromisos con el dragón.","trigger":"Cuando las protagonistas rechacen un vínculo y se les permita partir.","optional":false,"alternate":""},{"id":29,"act":"F","name":"Final C — Apagar las tres runas","category":"Desenlace","feel":"Supervivencia y liberación","title":"The End of the Quest","artist":"Bardify","videoId":"9GfNlO0tBXk","desc":"Cambia desde el tema de combate cuando se deshaga la manifestación. Debe sentirse como supervivencia y liberación, no como la muerte definitiva del dragón.","trigger":"En el momento de apagar la última ancla.","optional":false,"alternate":""},{"id":30,"act":"F","name":"Epílogo — Regreso a Neverwinter","category":"Desenlace","feel":"Despedida y reflexión","title":"Hegelburg","artist":"ASKII","videoId":"miVrpUDGDOM","desc":"Para la reunión con Maela, el informe a Branik y las reflexiones finales de las aventureras.","trigger":"Al regresar con los rescatados a la ciudad.","optional":false,"alternate":""}];
const SCENE_BY_ID=new Map(scenes.map(s=>[s.id,s]));
const $=id=>document.getElementById(id);
const yt=(id)=>'https://www.youtube.com/watch?v='+encodeURIComponent(id);
const STORAGE='deathsleep_soundtrack_guide_v2';
let restored={};try{restored=JSON.parse(localStorage.getItem(STORAGE)||'{}')||{}}catch(e){}
let state={act:['1','2','3','4','F'].includes(restored.act)?restored.act:'1',selected:SCENE_BY_ID.has(restored.selected)?restored.selected:1,done:new Set(Array.isArray(restored.done)?restored.done:[]),fav:new Set(Array.isArray(restored.fav)?restored.fav:[]),onlyFav:false,onlyPending:false,all:false,guideFilter:'Todos',playerId:null,playerPaused:false};
function save(){try{localStorage.setItem(STORAGE,JSON.stringify({act:state.act,selected:state.selected,done:[...state.done],fav:[...state.fav]}))}catch(e){}}
function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function actLabel(act){return act.id==='F'?'✦ FINALES':`ACTO ${act.roman} · ${act.name}`}
function badgeCategory(c){return `<span class="tag">${esc(c)}</span>`}
function renderTabs(){ $('actTabs').innerHTML=acts.map(a=>`<button type="button" class="act-tab ${state.act===a.id?'active':''}" role="tab" aria-selected="${state.act===a.id}" data-act="${a.id}">${a.id==='F'?'✦':a.roman} <small>${esc(a.name)}</small></button>`).join('') }
function renderStage(){const preservedPlayer=$('persistentPlayer');let s=SCENE_BY_ID.get(state.selected)||scenes[0];let idx=scenes.indexOf(s);let badge=s.optional?'<span class="tag opt">Opcional</span>':'';
$('stage').innerHTML=`<div class="stage-sub">${badgeCategory(s.category)}${badge}<span class="scene-counter">ESCENA ${String(s.id).padStart(2,'0')} / 30</span></div>
<h3>${esc(s.name)}</h3><div class="cue"><b>CUÁNDO INICIAR</b><br>${esc(s.trigger)}</div>
<div class="track-card"><div class="record-icon" aria-hidden="true">♫</div><div><div class="eyebrow" style="font-size:.6rem">PISTA ASIGNADA · APROX. 1 H</div><strong>${esc(s.title)}</strong><small>${esc(s.artist)} · ${esc(s.feel)}</small></div></div>
<p class="stage-desc">${esc(s.desc)}</p>${s.alternate?`<p class="alt-note">↳ ${esc(s.alternate)}</p>`:''}
<div class="actions"><button type="button" class="action primary" data-control="play">▶ Reproducir aquí</button><a class="action" href="${yt(s.videoId)}" target="_blank" rel="noopener noreferrer">↗ Abrir YouTube</a><button class="action ghost" type="button" data-control="pause">Ⅱ Pausar / silencio</button></div>
<div class="control-row"><button class="action" type="button" data-control="prev" ${idx===0?'disabled':''}>‹ Anterior</button><button class="action" type="button" data-control="done">${state.done.has(s.id)?'✓ Completada':'○ Marcar hecha'}</button><button class="action" type="button" data-control="fav">${state.fav.has(s.id)?'★ Favorita':'☆ Favorita'}</button><button class="action stretch" type="button" data-control="next" ${idx===scenes.length-1?'disabled':''}>Siguiente ›</button></div>
<div class="now-status" id="playStatus" aria-live="polite"></div><div id="playerLocation"></div>`;
const shell=preservedPlayer;if(shell)$('playerLocation').appendChild(shell);else $('playerLocation').innerHTML='<div class="player-shell" id="persistentPlayer"><div class="player-placeholder">El reproductor aparecerá aquí al iniciar una pista. Si YouTube no permite incrustarla, usa «Abrir YouTube».</div></div>';
updateStatus(); $('dockTitle').textContent=`${String(s.id).padStart(2,'0')} · ${s.name}`;
}
function updateStatus(){let el=$('playStatus');if(!el)return;let playing=SCENE_BY_ID.get(state.playerId);el.textContent=playing?`Reproductor: ${playing.title} — ${state.playerPaused?'pausado':'activo (depende de YouTube)'}`:'Ninguna pista cargada todavía.'}
function renderQueue(){let q=$('sceneSearch').value.trim().toLocaleLowerCase('es');let list=scenes.filter(s=>state.all||s.act===state.act).filter(s=>!state.onlyFav||state.fav.has(s.id)).filter(s=>!state.onlyPending||!state.done.has(s.id)).filter(s=>!q||`${s.id} ${s.name} ${s.title} ${s.artist} ${s.category} ${s.feel}`.toLocaleLowerCase('es').includes(q));$('queueCount').textContent=`${list.length} ${list.length===1?'escena':'escenas'}`;
$('queueList').innerHTML=list.map(s=>`<div class="queue-item ${s.id===state.selected?'current':''}"><button class="queue-select" type="button" data-select="${s.id}" aria-current="${s.id===state.selected?'true':'false'}"><span class="queue-index">${String(s.id).padStart(2,'0')}</span><span class="queue-main"><strong>${esc(s.name)}</strong><small>${esc(s.category)}${s.optional?' · Opcional':''}</small></span></button><div class="queue-tools"><button class="mini ${state.fav.has(s.id)?'fav':''}" type="button" title="Favorita" aria-label="Favorita ${esc(s.name)}" data-fav="${s.id}">${state.fav.has(s.id)?'★':'☆'}</button><button class="mini ${state.done.has(s.id)?'done':''}" type="button" title="Marcar escena completada" aria-label="Marcar hecha ${esc(s.name)}" data-done="${s.id}">${state.done.has(s.id)?'✓':'○'}</button><button class="mini" type="button" title="Reproducir esta pista" aria-label="Reproducir ${esc(s.title)}" data-play="${s.id}">▶</button></div></div>`).join('') || '<div class="empty">No hay escenas con estos filtros. Prueba «Todos los actos» o borra la búsqueda.</div>';
$('onlyFavorites').classList.toggle('on',state.onlyFav);$('onlyFavorites').setAttribute('aria-pressed',state.onlyFav);$('onlyPending').classList.toggle('on',state.onlyPending);$('onlyPending').setAttribute('aria-pressed',state.onlyPending);$('allScenes').classList.toggle('on',state.all);$('allScenes').setAttribute('aria-pressed',state.all);
$('progressCount').textContent=state.done.size+'/30';$('progressFill').style.width=(state.done.size/scenes.length*100)+'%'; }
function guideCategories(){return ['Todos','Exploración','Combate','Investigación','Diálogo','Tensión','Descanso','Revelación','Desenlace']}
function renderGuide(){let f=state.guideFilter;$('guideFilters').innerHTML=guideCategories().map(v=>`<button type="button" data-guide-filter="${v}" class="${f===v?'selected':''}">${v}</button>`).join('');$('detailedGuide').innerHTML=acts.map(a=>{let ss=scenes.filter(s=>s.act===a.id&&(f==='Todos'||s.category===f));if(!ss.length)return '';return `<article class="act-section" id="acto-${a.id}"><div class="act-banner" style="background-image:url('${a.picture}')"><div><div class="eyebrow">${a.id==='F'?'Finales alternativos y epílogo':'ACTO '+a.roman+' · '+esc(a.duration)}</div><h3>${esc(a.name)} · ${esc(a.subtitle)}</h3><p>${esc(a.mood)}</p></div></div><div class="scene-grid">${ss.map(s=>`<section class="detail" id="escena-${s.id}"><div class="topline"><span>${String(s.id).padStart(2,'0')}</span><span>·</span><span>${esc(s.category.toUpperCase())}</span>${s.optional?'<span>· OPCIONAL</span>':''}</div><h4>${esc(s.name)}</h4><div class="sub">${esc(s.feel)}</div><div class="musictitle">♫ ${esc(s.title)} <span>— ${esc(s.artist)} (aprox. 1 h)</span></div><p class="when"><b>Momento:</b> ${esc(s.trigger)}</p><p>${esc(s.desc)}</p>${s.alternate?`<p class="alt-note">${esc(s.alternate)}</p>`:''}<div class="detail-links"><a class="action small" target="_blank" rel="noopener noreferrer" href="${yt(s.videoId)}">↗ YouTube</a><button class="action small" data-focus="${s.id}" type="button">↑ Llevar al panel</button></div></section>`).join('')}</div><p class="transition"><strong>${a.id==='F'?'Cierre del relato':'Transición musical'}:</strong> ${esc(a.transition)}</p></article>`}).join('')}
function render(){renderTabs();renderStage();renderQueue();save()}
function choose(id,scroll=false){let s=SCENE_BY_ID.get(Number(id));if(!s)return;state.selected=s.id;state.act=s.act;render();if(scroll)$('cabina').scrollIntoView({behavior:'smooth',block:'start'})}
function step(delta){let i=scenes.findIndex(s=>s.id===state.selected);let next=scenes[i+delta];if(next)choose(next.id)}
function toggleDone(id){state.done.has(id)?state.done.delete(id):state.done.add(id);render()}
function toggleFav(id){state.fav.has(id)?state.fav.delete(id):state.fav.add(id);render()}
function start(id){const s=SCENE_BY_ID.get(id||state.selected);if(!s)return;if(state.selected!==s.id)choose(s.id);state.playerId=s.id;state.playerPaused=false;const iframe=document.createElement('iframe');iframe.className='yt-frame';iframe.title='Reproductor de YouTube: '+s.title;iframe.allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';iframe.allowFullscreen=true;iframe.referrerPolicy='strict-origin-when-cross-origin';iframe.src='https://www.youtube-nocookie.com/embed/'+encodeURIComponent(s.videoId)+'?autoplay=1&rel=0&playsinline=1&enablejsapi=1';const p=$('persistentPlayer');p.replaceChildren(iframe);updateStatus();}
function pause(){let frame=document.querySelector('#persistentPlayer iframe');if(!frame)return;state.playerPaused=!state.playerPaused;try{frame.contentWindow.postMessage(JSON.stringify({event:'command',func:state.playerPaused?'pauseVideo':'playVideo',args:[]}), '*')}catch(e){}updateStatus()}
$('actTabs').addEventListener('click',e=>{let b=e.target.closest('[data-act]');if(!b)return;state.act=b.dataset.act;state.all=false;const found=scenes.find(s=>s.act===state.act);if(found)state.selected=found.id;render()});
$('queueList').addEventListener('click',e=>{const p=e.target.closest('[data-play]'),c=e.target.closest('[data-done]'),f=e.target.closest('[data-fav]'),s=e.target.closest('[data-select]');if(p){start(Number(p.dataset.play));return}if(c){toggleDone(Number(c.dataset.done));return}if(f){toggleFav(Number(f.dataset.fav));return}if(s)choose(s.dataset.select)});
$('stage').addEventListener('click',e=>{let b=e.target.closest('[data-control]');if(!b)return;switch(b.dataset.control){case'play':start();break;case'pause':pause();break;case'next':step(1);break;case'prev':step(-1);break;case'done':toggleDone(state.selected);break;case'fav':toggleFav(state.selected);break}});
$('sceneSearch').addEventListener('input',renderQueue);$('onlyFavorites').addEventListener('click',()=>{state.onlyFav=!state.onlyFav;renderQueue()});$('onlyPending').addEventListener('click',()=>{state.onlyPending=!state.onlyPending;renderQueue()});$('allScenes').addEventListener('click',()=>{state.all=!state.all;renderQueue()});
$('guideFilters').addEventListener('click',e=>{let b=e.target.closest('[data-guide-filter]');if(!b)return;state.guideFilter=b.dataset.guideFilter;renderGuide()});$('detailedGuide').addEventListener('click',e=>{let b=e.target.closest('[data-focus]');if(b)choose(b.dataset.focus,true)});
$('dockPlay').addEventListener('click',()=>{start();$('cabina').scrollIntoView({behavior:'smooth',block:'start'})});$('dockNext').addEventListener('click',()=>{step(1);$('cabina').scrollIntoView({behavior:'smooth',block:'start'})});
window.addEventListener('keydown',e=>{if(e.ctrlKey||e.metaKey||e.altKey)return;let t=e.target;if(t&&(['INPUT','TEXTAREA'].includes(t.tagName)||t.isContentEditable))return;if(e.key==='/'){e.preventDefault();$('sceneSearch').focus()}else if(e.key==='ArrowRight'){step(1)}else if(e.key==='ArrowLeft'){step(-1)}});
renderGuide();render();
</script>
</body></html>