@'
# Fuentes y manuales locales
/00-Fuentes/

# Paquetes y respaldos comprimidos
*.zip
*.7z
*.rar

# Entornos y dependencias
node_modules/
__pycache__/
.pytest_cache/
.env
.env.*
!.env.example

# Perfiles temporales de navegadores
**/browser-profile/
**/qa-*/profile/

# Descargas y archivos temporales
**/qa-*/downloads/
*.crdownload
*.tmp
*.log

# Evidencia visual generada por pruebas
**/qa-responsive/before/
**/qa-responsive/after/
**/qa-responsive/regression/

# Archivos del sistema
.DS_Store
Thumbs.db
desktop.ini
'@ | Set-Content -Path .gitignore -Encoding utf8